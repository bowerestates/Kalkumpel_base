# Supabase — Project Settings → API (https://supabase.com/dashboard/project/_/settings/api)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Anthropic key is NO LONGER a client env var. It lives only as a Supabase Edge
# Function secret (analyze-meal): `supabase secrets set ANTHROPIC_API_KEY=...`.
# Never put it in EXPO_PUBLIC_* — that ships it in the client bundle.
